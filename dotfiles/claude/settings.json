{
  "env": {
    "CLAUDE_CODE_DISABLE_SUBSTITUTION_RM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_INLINE_SHELL_RM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_MOUNTED_DRIVE_RM_PROMPT": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/ofirg/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "atlassian-mcp@anthropic-plugin-directory": true,
    "prismantis@prismantis": true
  },
  "extraKnownMarketplaces": {
    "prismantis": {
      "source": {
        "source": "github",
        "repo": "NahumLitvin/prismantis"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium",
      "autoCompactWindow": 300000
    }
  },
  "pluginConfigs": {
    "prismantis@prismantis": {
      "options": {
        "theme": "catppuccin-mocha",
        "promptStyle": "wide",
        "toolOutput": "quiet",
        "clock": "24h",
        "codeStyle": "filled",
        "tableStyle": "box",
        "taskStyle": "progress",
        "listMarker": "dots",
        "headingStyle": "banner",
        "copyButtonStyle": "dim",
        "replyStyle": "off",
        "bubbleLabels": "off",
        "toolStyle": "tree-bold",
        "diffStyle": "full",
        "pieStyle": "round",
        "mermaid": false,
        "inlineCodeColor": "#fab387",
        "strongColor": "#cba6f7"
      }
    }
  },
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true
}

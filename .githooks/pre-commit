#!/bin/sh

# Unstage submodules listed in wip-submodules
if [ -f wip-submodules ]; then
    while IFS= read -r mod || [ -n "$mod" ]; do
        mod=$(echo "$mod" | sed 's/#.*//' | xargs)
        [ -z "$mod" ] && continue
        if git diff --cached --name-only | grep -q "^$mod"; then
            echo "wip-submodules: unstaging $mod"
            git reset HEAD -- "$mod"
        fi
    done < wip-submodules
fi

# Add submodules (the ones that track their own branch heads; paths are inside their packages)
for mod in packages/koala-config/KoalaConfig packages/zsh/zsh-conf packages/hyprland/hypr-dots packages/vscode/vscode-settings; do
    [ -e "$mod/.git" ] && git add "$mod"
done
exit 0

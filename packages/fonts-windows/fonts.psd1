# zip name in the nerd-fonts release -> file name pattern the installed fonts match
@{
    NerdFontsVersion = 'v3.3.0'
    MapleVersion     = 'v7.0-beta36'
    Fonts = [ordered]@{
        CascadiaCode  = 'CaskaydiaCove'
        UbuntuMono    = 'UbuntuMono'
        JetBrainsMono = 'JetBrainsMono'
        IosevkaTerm   = 'IosevkaTerm'
        CommitMono    = 'CommitMono'
        '0xProto'     = '0xProto'
        Recursive     = 'RecMono'
    }
}

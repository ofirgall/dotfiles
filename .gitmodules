[submodule "dotbot"]
	path = dotbot
	url = https://github.com/anishathalye/dotbot
	ignore = dirty
[submodule "packages/koala-config/KoalaConfig"]
	path = packages/koala-config/KoalaConfig
	url = https://github.com/ofirgall/KoalaConfig.git
	ignore = dirty
[submodule "packages/zsh/zsh-conf"]
	path = packages/zsh/zsh-conf
	url = https://github.com/ofirgall/zsh-conf.git
	ignore = dirty
[submodule "packages/vscode/vscode-settings"]
	path = packages/vscode/vscode-settings
	url = https://github.com/ofirgall/vscode-settings.git
[submodule "packages/hyprland/hypr-dots"]
	path = packages/hyprland/hypr-dots
	url = https://github.com/ofirgall/hypr-dots.git
	ignore = dirty
[submodule "packages/agents-status/agents-status"]
	path = packages/agents-status/agents-status
	url = https://github.com/KoalaVim/agents-status.git
	ignore = dirty
